#!/usr/bin/env python3
"""bserve — BHTTP/2 file server. usage: bserve <docroot> <port>"""
import os
import socket
import sys
import threading
import time

import bframe

SERVER_NAME = "bserve/0.2"

CONTENT_TYPES = {
    ".html": "text/html",
    ".txt": "text/plain",
    ".png": "image/png",
    ".bin": "application/octet-stream",
}

STATUS_TEXT = {
    200: "OK",
    400: "Bad Request",
    404: "Not Found",
    405: "Method Not Allowed",
}

PSEUDO_HEADERS = (":method", ":path", ":authority")


class RequestError(Exception):
    """Malformed request. stream_id is what to echo in the 400, which is 0
    when the request never got far enough to have one."""

    def __init__(self, msg, stream_id=0):
        super().__init__(msg)
        self.stream_id = stream_id


def http_date():
    return time.strftime("%a, %d %b %Y %H:%M:%S GMT", time.gmtime())


def send_response(conn, stream_id, headers, body=b""):
    payload = bframe.encode_headers(headers)
    flags = bframe.FLAG_END_HEADERS
    if not body:
        flags |= bframe.FLAG_END_STREAM
    conn.sendall(bframe.pack_frame(bframe.TYPE_HEADERS, flags, stream_id, payload))
    for i in range(0, len(body), bframe.MAX_PAYLOAD):
        chunk = body[i:i + bframe.MAX_PAYLOAD]
        end = bframe.FLAG_END_STREAM if i + bframe.MAX_PAYLOAD >= len(body) else 0
        conn.sendall(bframe.pack_frame(bframe.TYPE_DATA, end, stream_id, chunk))


def send_status(conn, stream_id, status):
    body = ("%d %s\n" % (status, STATUS_TEXT[status])).encode()
    headers = [
        (":status", str(status)),
        ("content-type", "text/plain"),
        ("content-length", str(len(body))),
        ("server", SERVER_NAME),
        ("date", http_date()),
    ]
    send_response(conn, stream_id, headers, body)


def pseudo_ok(headers):
    """RFC 9113 section 8.3: pseudo-headers come first, never repeat, and
    only the defined ones are allowed. Returns a reason or None."""
    seen = set()
    saw_regular = False
    for name, value in headers:
        if not name.startswith(":"):
            saw_regular = True
        elif saw_regular:
            return "pseudo-header after regular headers"
        elif name in seen:
            return "duplicate pseudo-header " + name
        elif name not in PSEUDO_HEADERS:
            return "unknown pseudo-header " + name
        else:
            seen.add(name)
    return None


def handle_request(conn, headers, stream_id, docroot):
    """One request. Returns False when the connection has to close."""
    h = dict(headers)
    reason = pseudo_ok(headers)
    if reason is not None or ":method" not in h or ":path" not in h:
        send_status(conn, stream_id, 400)
        return False

    if h[":method"] != "GET":
        send_status(conn, stream_id, 405)
        return True

    path = h[":path"]
    if path == "/":
        path = "/index.html"

    # no traversal: reject ".." outright and keep normpath inside the root
    if ".." in path.split("/"):
        send_status(conn, stream_id, 404)
        return True
    full = os.path.normpath(os.path.join(docroot, path.lstrip("/")))
    if not full.startswith(docroot + os.sep) or not os.path.isfile(full):
        send_status(conn, stream_id, 404)
        return True

    with open(full, "rb") as f:
        body = f.read()
    ext = os.path.splitext(full)[1]
    headers = [
        (":status", "200"),
        ("content-type", CONTENT_TYPES.get(ext, "application/octet-stream")),
        ("content-length", str(len(body))),
        ("server", SERVER_NAME),
        ("date", http_date()),
    ]
    send_response(conn, stream_id, headers, body)
    return True


def read_request(sock):
    """Frames until END_STREAM. Returns (headers, stream_id), or None when
    the peer closed cleanly between requests. Any body DATA frames are
    read and dropped, so the connection stays in sync even for methods
    we end up rejecting."""
    headers = None
    while True:
        frame = bframe.read_frame(sock)
        if frame is None:
            if headers is None:
                return None
            raise RequestError("connection died mid request")
        ftype, flags, sid, payload = frame
        if headers is None:
            if ftype == bframe.TYPE_DATA:
                raise RequestError("request did not start with HEADERS")
            if ftype == bframe.TYPE_HEADERS:
                if sid == 0 or sid % 2 == 0:
                    raise RequestError("bad stream id %d" % sid, sid)
                if not flags & bframe.FLAG_END_HEADERS:
                    raise RequestError("HEADERS without END_HEADERS", sid)
                if flags & 0x08 or flags & 0x20:
                    raise RequestError("padding/priority are not supported",
                                       sid)
                headers = bframe.decode_headers(payload)  # FrameError -> 400
                stream_id = sid
            # anything else is a control/unknown frame before the request:
            # skip it, exactly like HTTP/2 says to
        elif ftype == bframe.TYPE_HEADERS:
            raise RequestError("second HEADERS in one request", stream_id)
        # DATA payloads and unknown frame types: read and drop
        if flags & bframe.FLAG_END_STREAM:
            if headers is None:
                raise RequestError("request ended without HEADERS")
            return headers, stream_id


def serve_conn(conn, docroot):
    last_sid = 0
    try:
        while True:
            req = read_request(conn)
            if req is None:
                return
            headers, sid = req
            if sid <= last_sid:
                raise RequestError("stream id %d not increasing" % sid, sid)
            last_sid = sid
            if not handle_request(conn, headers, sid, docroot):
                return
    except RequestError as e:
        try:
            send_status(conn, e.stream_id, 400)
        except OSError:
            pass
    except bframe.FrameError:
        try:
            send_status(conn, 0, 400)
        except OSError:
            pass
    except OSError:
        pass


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: bserve <docroot> <port>")
    docroot = os.path.abspath(sys.argv[1])
    if not os.path.isdir(docroot):
        sys.exit("%s is not a directory" % docroot)
    port = int(sys.argv[2])

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("", port))
    sock.listen(8)
    print("bserve serving %s on port %d" % (docroot, port))

    def handle(conn):
        try:
            serve_conn(conn, docroot)
        finally:
            conn.close()

    try:
        while True:
            conn, _ = sock.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except KeyboardInterrupt:
        print("\nbye")


if __name__ == "__main__":
    main()
